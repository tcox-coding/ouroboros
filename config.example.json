    "openai": {
      "model": "gpt-5",
      "reasoning_effort": "low",
      "image_detail": "low",
      "price_per_mtok": {
        "input": 1.25,
        "cached_input": 0.125,
        "output": 10.0
      }
    },
    "rubric": {
      "identity": {
        "weight": 3,
        "anchors": "Same character: face, hair, body type, outfit. 10 = indistinguishable character; 7 = same character, minor differences; 4 = same archetype, clear differences; 0 = unrelated."
      },
      "composition": {
        "weight": 2,
        "anchors": "Pose, framing, camera angle, placement. 10 = matches; 5 = similar framing, different pose; 0 = unrelated."
      },
      "style": {
        "weight": 2,
        "anchors": "Line work, shading, rendering style. 10 = same artist look; 5 = same medium, different treatment; 0 = different medium."
      },
      "color": {
        "weight": 1.5,
        "anchors": "Palette of hair, skin, clothing, background. 10 = matches; 5 = right hues, wrong values; 0 = wrong colours."
      },
      "quality": {
        "weight": 1.5,
        "anchors": "Anatomy and artifacts (hands, limbs, faces, duplicates, text). 10 = clean; 5 = one noticeable flaw; 0 = broken."
      }
    },
    "rubric_optional": {
      "extras": {
        "weight": 1.5,
        "anchors": "Items or details the reference does NOT have (accessories, emblems, patches, straps, jewelry, props, extra clothing layers). 10 = nothing extra; 6 = one small addition; 3 = one prominent addition or several small ones; 0 = many."
      }
    },
    "scoring": "per_candidate",
    "confirm_model": "",
    "prompt_model": "",
    "prompt_options": {},
    "confirm_options": {},
    "confirm_thresholds": {
      "loop": null,
      "designer": null
    }
  },
  "loop": {
    "threshold": 62,
    "max_rounds": 10,
